# Copy to .env.local. Local values: `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Used for storage cleanup after a failed submit (Phase 1). Never import client-side.
SUPABASE_SECRET_KEY=sb_secret_...
# Server-only. Powers /ask (Claude Haiku 5.5). Get one at console.anthropic.com. Never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...
